{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansoku.example/schemas/flow-record.schema.json",
  "title": "KANSOKU Aggregated Flow Record",
  "type": "object",
  "required": ["capture_id", "target", "source", "ip_version", "protocol", "src_ip", "dst_ip", "src_port", "dst_port", "packets", "captured_bytes", "wire_bytes", "first_seen", "last_seen", "vlan_id", "tcp_flags", "metadata", "flow_id"],
  "properties": {
    "capture_id": {"type": "string"},
    "target": {"type": "string"},
    "source": {"type": "string"},
    "ip_version": {"enum": [4, 6]},
    "protocol": {"type": "string"},
    "src_ip": {"type": "string"},
    "dst_ip": {"type": "string"},
    "src_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "dst_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "packets": {"type": "integer", "minimum": 1},
    "captured_bytes": {"type": "integer", "minimum": 0},
    "wire_bytes": {"type": "integer", "minimum": 0},
    "first_seen": {"type": "string", "format": "date-time"},
    "last_seen": {"type": "string", "format": "date-time"},
    "vlan_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 4095},
    "tcp_flags": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "metadata": {"type": "object"},
    "flow_id": {"type": "string"}
  },
  "additionalProperties": false
}
