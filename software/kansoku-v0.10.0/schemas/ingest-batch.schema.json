{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansoku.example/schemas/ingest-batch.schema.json",
  "title": "KANSOKU Remote Ingest Batch",
  "type": "object",
  "required": [
    "agent_id",
    "observations",
    "runs",
    "captures",
    "flows",
    "batch_id",
    "sent_at"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 10000
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    "batch_id": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 100
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 20000
    }
  },
  "additionalProperties": false
}
