{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kansoku/evidence-graph.schema.json",
  "title": "KANSOKU Evidence Graph",
  "type": "object",
  "required": ["graph_id", "assessment_id", "flow_id", "generated_at", "nodes", "edges", "metadata"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "flow_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "label", "source_id", "confidence", "attributes"],
        "properties": {
          "node_id": {"type": "string"},
          "node_type": {"type": "string"},
          "label": {"type": "string"},
          "source_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "attributes": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "source_node_id", "target_node_id", "relation", "confidence", "attributes"],
        "properties": {
          "edge_id": {"type": "string"},
          "source_node_id": {"type": "string"},
          "target_node_id": {"type": "string"},
          "relation": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "attributes": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
