{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansoku.example/schemas/scenario-catalog.schema.json",
  "title": "ScenarioCatalog",
  "type": "object",
  "required": ["schema_version", "catalog", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "layer", "fault_type", "implemented"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1},
          "fault_type": {"type": "string", "minLength": 1},
          "implemented": {"type": "boolean"},
          "expected_verdict": {"type": "string"},
          "expected_category": {"type": "string"},
          "expected_recovery": {"type": ["boolean", "null"]},
          "description": {"type": "string"},
          "topology": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
