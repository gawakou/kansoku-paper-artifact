{
  "nftables": [
    {"metainfo": {"json_schema_version": 1}},
    {"table": {"family": "inet", "name": "filter"}},
    {"chain": {"family": "inet", "table": "filter", "name": "forward", "type": "filter", "hook": "forward", "prio": 0, "policy": "drop"}},
    {"rule": {
      "family": "inet", "table": "filter", "chain": "forward", "handle": 10,
      "expr": [
        {"match": {"op": "==", "left": {"payload": {"protocol": "ip", "field": "saddr"}}, "right": "10.0.0.0/24"}},
        {"match": {"op": "==", "left": {"payload": {"protocol": "tcp", "field": "dport"}}, "right": 443}},
        {"counter": {"packets": 12, "bytes": 1024}},
        {"accept": null}
      ],
      "comment": "Allow client HTTPS"
    }},
    {"rule": {
      "family": "inet", "table": "filter", "chain": "forward", "handle": 100,
      "expr": [{"counter": {"packets": 2, "bytes": 128}}, {"drop": null}],
      "comment": "Default deny"
    }}
  ]
}
