    "rollback_success": "All rollback commands complete successfully.",
    "security_invariant_preservation": "TCP/8443 remains unreachable from client-a while an actual TCP/8443 service is listening on server-a.",
    "target_recovery": "TCP/443 target service becomes reachable after remediation.",
    "what_if_actual_agreement": "A preregistered PASSED/ALLOW what-if prediction agrees with successful observed post-change TCP/443 recovery."
